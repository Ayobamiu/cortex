{
  "id": "my-project",
  "objective": "Describe the big goal in a few sentences: what exists when this is done, and for whom. Say what's out of scope, and which decisions the agents may make themselves versus ask you about.",
  "context_files": ["SPEC.md"],
  "acceptance": [
    { "kind": "command", "run": "npm test" },
    { "kind": "judge", "criterion": "Every requirement in SPEC.md is implemented and covered by a passing test." }
  ],
  "agents": {
    "claude": { "adapter": "claude", "model": "opus", "permission_mode": "auto" },
    "claude-judge": { "adapter": "claude", "model": "sonnet", "permission_mode": "auto" },
    "cursor": { "adapter": "cursor", "extra_args": ["--force", "--trust"], "provider": "cursor" },
    "cursor-judge": { "adapter": "cursor", "extra_args": ["--mode", "ask", "--trust"], "provider": "cursor" }
  },
  "routing": {
    "plan": "claude",
    "research": ["cursor", "claude"],
    "code": ["cursor", "claude"],
    "review": ["cursor", "claude"],
    "redteam": ["cursor", "claude"],
    "deep": ["claude", "cursor"],
    "judge": ["cursor-judge", "claude-judge"]
  },
  "budget": {
    "usd_total": 40,
    "usd_per_attempt": 5,
    "max_attempts_per_task": 3,
    "max_replans": 8,
    "max_hours": 72,
    "attempt_timeout_min": 60
  },
  "concurrency": 2,
  "checkpoint_every": 5,
  "notify": { "macos": true }
}

#!/usr/bin/env node
// Fake `claude -p --output-format stream-json`: records its args, emits the event shapes
// the real CLI does. FAKE_MODE=ok | rejected.
import { readFileSync, writeFileSync } from 'node:fs';
readFileSync(0, 'utf8');
if (process.env.FAKE_ARGS_FILE) writeFileSync(process.env.FAKE_ARGS_FILE, JSON.stringify(process.argv.slice(2)));
const reset = Math.floor(Date.now() / 1000) + 3600;
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
out({ type: 'system', subtype: 'init' });
out({ type: 'assistant', message: { content: [{ type: 'text', text: 'working' }] } });
if (process.env.FAKE_MODE === 'rejected') {
  out({ type: 'rate_limit_event', rate_limit_info: { status: 'rejected', resetsAt: reset, rateLimitType: 'five_hour',
    unifiedWindows: { five_hour: { utilization: 1, resetsAt: reset, status: 'rejected' }, seven_day: { utilization: 0.5, resetsAt: reset + 86400, status: 'allowed' } } } });
  out({ type: 'result', subtype: 'error_during_execution', is_error: true, result: 'limit', total_cost_usd: 0 });
  process.exit(1);
}
out({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', resetsAt: reset,
  unifiedWindows: { five_hour: { utilization: 0.42, resetsAt: reset, status: 'allowed' }, seven_day: { utilization: 0.18, resetsAt: reset + 86400, status: 'allowed' } } } });
out({ type: 'result', subtype: 'success', is_error: false, result: 'done', structured_output: { pass: true, reason: 'ok' }, total_cost_usd: 0.25 });
